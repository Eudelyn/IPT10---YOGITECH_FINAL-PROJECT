# ── Application ─────────────────────────────
APP_NAME=Yogitech
APP_ENV=local
# true shows error details (handy while coding). Keep false for demos and submission.
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
LOG_REQUESTS=true
# Leave blank to auto-detect. Only set if pages show 404, e.g. APP_BASE=/yogitech
APP_BASE=

# ── Database (XAMPP default: root with no password) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yogitech
DB_USERNAME=root
DB_PASSWORD=

# ── External APIs ───────────────────────────
# Mock gadget catalog (no key needed)
PRODUCTS_API_URL=https://dummyjson.com
# Live USD → PHP exchange rate (no key needed)
EXCHANGE_API_URL=https://open.er-api.com/v6/latest/USD
FALLBACK_USD_PHP=58.50
# Set to false only if XAMPP on Windows shows "SSL certificate problem"
HTTP_VERIFY_SSL=true

# ── Store settings ──────────────────────────
FREE_SHIPPING_THRESHOLD=10000

# ── Email notifications ─────────────────────
# MAIL_DRIVER: log (save to storage/mail, no sending) | gmail (Gmail API, real inboxes) | mailtrap (sandbox inbox for demos) | brevo (Brevo API) | smtp
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=lynsaldevar@gmail.com
MAIL_FROM_NAME=Yogitech
# Full site address used in email links, e.g. http://localhost/yogitech/yogitech
APP_URL=
# Used for email links only when APP_URL is blank. Links never use other hosts (blocks Host-header tricks).
APP_TRUSTED_HOSTS=localhost,127.0.0.1
# false = one store, sign-up makes shopper accounts only. true = anyone can open a store.
ALLOW_SELLER_SIGNUP=false

# Gmail API (recommended for real emails): README → "Gmail API" for the 5-minute setup.
# Paste the client ID/secret from Google Cloud, then run: php yogi gmail:auth (fills the token for you).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Mailtrap Email Sandbox API (free): mailtrap.io → Sandboxes → open your inbox.
#   MAILTRAP_INBOX_ID = the number in the inbox URL: mailtrap.io/inboxes/<number>/messages
#   MAILTRAP_API_TOKEN = Settings → API Tokens → Add token (give it access to that sandbox)
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=

# Option 1 — Brevo API (free 300/day): brevo.com → SMTP & API → API keys → Generate
BREVO_API_KEY=

# Option 2 — Gmail SMTP: use a 16-character App Password, NOT your Gmail password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=lynsaldevar@gmail.com
SMTP_PASSWORD=

# ── Payments (sandbox, no real money) ───────
# sandbox = built-in GCash/card simulator (default) | paymongo = PayMongo test mode (needs sk_test_ key + KYC)
PAYMENT_GATEWAY=sandbox
SANDBOX_GCASH_BALANCE=150000
PAYMONGO_SECRET_KEY=
